{
  "apiVersion": "traefik.io/v1alpha1",
  "kind": "Middleware",
  "metadata": {
    "name": "ml-ui-headers"
  },
  "spec": {
    "headers": {
      "referrerPolicy": "no-referrer",
      "stsSeconds": 31536000,
      "contentTypeNosniff": true,
      "customResponseHeaders": {
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "Cache-Control": "no-store"
      }
    }
  }
}
