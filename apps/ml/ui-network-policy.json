{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "ml-ui-ingress-only"
  },
  "spec": {
    "podSelector": {
      "matchExpressions": [
        {
          "key": "app",
          "operator": "In",
          "values": [
            "airflow",
            "superset"
          ]
        }
      ]
    },
    "policyTypes": [
      "Ingress"
    ],
    "ingress": [
      {
        "from": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "kube-system"
              }
            },
            "podSelector": {
              "matchLabels": {
                "app.kubernetes.io/name": "traefik"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 8080
          },
          {
            "protocol": "TCP",
            "port": 8088
          }
        ]
      }
    ]
  }
}
