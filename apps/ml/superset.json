{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "superset"
  },
  "spec": {
    "replicas": 1,
    "strategy": {
      "type": "Recreate"
    },
    "selector": {
      "matchLabels": {
        "app": "superset"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "superset",
          "component": "ml"
        },
        "annotations": {
          "matchlab.io/credentials-generation": "1",
          "matchlab.io/ui-origin-generation": "2"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "runAsGroup": 0,
          "fsGroup": 0,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "imagePullSecrets": [
          {
            "name": "ghcr-pull"
          }
        ],
        "containers": [
          {
            "name": "superset",
            "image": "${SUPERSET_IMAGE}",
            "env": [
              {
                "name": "SUPERSET_CONFIG_PATH",
                "value": "/etc/superset-public/config.py"
              },
              {
                "name": "SUPERSET_SECRET_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "matchlab-superset",
                    "key": "secret-key"
                  }
                }
              },
              {
                "name": "SUPERSET_METADATA_URL",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "matchlab-superset",
                    "key": "metadata-url"
                  }
                }
              },
              {
                "name": "SUPERSET_ANALYTICS_URL",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "matchlab-superset",
                    "key": "analytics-url"
                  }
                }
              },
              {
                "name": "SUPERSET_APP_ROOT",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "matchlab-ml-ui",
                    "key": "superset-root"
                  }
                }
              }
            ],
            "volumeMounts": [
              {
                "name": "public-config",
                "mountPath": "/etc/superset-public",
                "readOnly": true
              }
            ],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "256Mi"
              },
              "limits": {
                "cpu": "2",
                "memory": "2Gi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "command": [
              "gunicorn"
            ],
            "args": [
              "--bind",
              "0.0.0.0:8088",
              "--workers",
              "1",
              "--timeout",
              "120",
              "superset.app:create_app()"
            ],
            "ports": [
              {
                "containerPort": 8088
              }
            ],
            "readinessProbe": {
              "initialDelaySeconds": 30,
              "periodSeconds": 10,
              "exec": {
                "command": [
                  "python",
                  "-c",
                  "import os,urllib.request; urllib.request.urlopen(\"http://127.0.0.1:8088\"+os.environ[\"SUPERSET_APP_ROOT\"]+\"/health\",timeout=3)"
                ]
              }
            },
            "startupProbe": {
              "periodSeconds": 10,
              "timeoutSeconds": 5,
              "failureThreshold": 90,
              "exec": {
                "command": [
                  "python",
                  "-c",
                  "import os,urllib.request; urllib.request.urlopen(\"http://127.0.0.1:8088\"+os.environ[\"SUPERSET_APP_ROOT\"]+\"/health\",timeout=3)"
                ]
              }
            },
            "livenessProbe": {
              "periodSeconds": 30,
              "timeoutSeconds": 5,
              "failureThreshold": 6,
              "exec": {
                "command": [
                  "python",
                  "-c",
                  "import os,urllib.request; urllib.request.urlopen(\"http://127.0.0.1:8088\"+os.environ[\"SUPERSET_APP_ROOT\"]+\"/health\",timeout=3)"
                ]
              }
            }
          }
        ],
        "volumes": [
          {
            "name": "public-config",
            "configMap": {
              "name": "superset-public-config"
            }
          }
        ]
      }
    }
  }
}
