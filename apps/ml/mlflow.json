{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "mlflow"
  },
  "spec": {
    "replicas": 1,
    "strategy": {
      "type": "Recreate"
    },
    "selector": {
      "matchLabels": {
        "app": "mlflow"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "mlflow",
          "component": "ml",
          "matchlab.io/ml-storage": "true"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 50000,
          "runAsGroup": 0,
          "fsGroup": 0,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "imagePullSecrets": [
          {
            "name": "ghcr-pull"
          }
        ],
        "containers": [
          {
            "name": "mlflow",
            "image": "${MLFLOW_IMAGE}",
            "env": [
              {
                "name": "MLFLOW_ENABLE_TELEMETRY",
                "value": "false"
              },
              {
                "name": "HOME",
                "value": "/tmp"
              },
              {
                "name": "USER",
                "value": "mlflow"
              }
            ],
            "volumeMounts": [
              {
                "name": "data",
                "mountPath": "/mlflow"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "256Mi"
              },
              "limits": {
                "cpu": "2",
                "memory": "2Gi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "command": [
              "/bin/sh",
              "-ec"
            ],
            "args": [
              "mlflow db upgrade sqlite:////mlflow/mlflow.db && exec mlflow server --host 0.0.0.0 --port 5000 --workers 1 --backend-store-uri sqlite:////mlflow/mlflow.db --artifacts-destination /mlflow/artifacts --serve-artifacts --allowed-hosts mlflow:5000,localhost:5000,127.0.0.1:5000"
            ],
            "ports": [
              {
                "containerPort": 5000
              }
            ],
            "readinessProbe": {
              "httpGet": {
                "path": "/health",
                "port": 5000
              },
              "initialDelaySeconds": 15,
              "periodSeconds": 10
            },
            "startupProbe": {
              "httpGet": {
                "path": "/health",
                "port": 5000
              },
              "periodSeconds": 10,
              "timeoutSeconds": 5,
              "failureThreshold": 90
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/health",
                "port": 5000
              },
              "periodSeconds": 30,
              "timeoutSeconds": 5,
              "failureThreshold": 6
            }
          }
        ],
        "volumes": [
          {
            "name": "data",
            "persistentVolumeClaim": {
              "claimName": "mlflow-data"
            }
          }
        ],
        "affinity": {
          "podAntiAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": [
              {
                "labelSelector": {
                  "matchLabels": {
                    "matchlab.io/ml-storage": "true"
                  }
                },
                "topologyKey": "kubernetes.io/hostname"
              }
            ]
          }
        }
      }
    }
  }
}
