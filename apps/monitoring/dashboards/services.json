{
  "uid": "matchlab-services",
  "title": "MatchLab — Services and releases",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "matchlab",
    "gitops",
    "KAN-60"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "matchlab-prometheus"
        },
        "query": "label_values(kube_pod_container_info{namespace=\"matchlab\"}, container)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Running image, digest, pod and node identity",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "matchlab-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_container_info{namespace=\"matchlab\",container=~\"$service\"}",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Container CPU cores",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "matchlab-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"matchlab\",pod=~\"($service)-.*\",container!=\"\",container!=\"POD\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Container RAM — working set",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "matchlab-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"matchlab\",pod=~\"($service)-.*\",container!=\"\",container!=\"POD\"})",
          "legendFormat": "{{pod}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Configured RAM limit",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "matchlab-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (kube_pod_container_resource_limits{namespace=\"matchlab\",container=~\"$service\",resource=\"memory\"})",
          "legendFormat": "{{pod}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Restarts in selected time range",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "matchlab-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"matchlab\",container=~\"$service\"}[$__range]))",
          "legendFormat": "{{pod}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "CPU throttled periods",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "matchlab-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (pod) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"matchlab\",pod=~\"($service)-.*\",container!=\"\",container!=\"POD\"}[$__rate_interval])) / clamp_min(sum by (pod) (rate(container_cpu_cfs_periods_total{namespace=\"matchlab\",pod=~\"($service)-.*\",container!=\"\",container!=\"POD\"}[$__rate_interval])), 0.001)",
          "legendFormat": "{{pod}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Container writable filesystem (when exported by runtime)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "matchlab-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_fs_usage_bytes{namespace=\"matchlab\",pod=~\"($service)-.*\",container!=\"\",container!=\"POD\"})",
          "legendFormat": "{{pod}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Persistent volume used (when supported by CSI)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "matchlab-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kubelet_volume_stats_used_bytes{namespace=\"matchlab\"}",
          "legendFormat": "{{persistentvolumeclaim}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
