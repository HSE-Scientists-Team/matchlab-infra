      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_transmit_bytes_total{node=~\"$node\",device!~\"lo|veth.*|cni.*|flannel.*\"}[$__rate_interval])",
          "legendFormat": "{{node}} {{device}}",
